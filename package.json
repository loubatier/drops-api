{
  "name": "drops-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:block2": "tsx scripts/smoke-block2.ts",
    "build-dataset": "tsx scripts/build-dataset.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loubatier/drops-api.git"
  },
  "bugs": {
    "url": "https://github.com/loubatier/drops-api/issues"
  },
  "homepage": "https://github.com/loubatier/drops-api#readme",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.2.1",
    "swagger-ui-dist": "^5.35.0",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/ws": "^8.18.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
